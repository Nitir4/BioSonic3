# BioSonic Frontend — Environment Variables
# ──────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and will NOT be committed.
#
# In Vercel: add this as an Environment Variable in
#   Project Settings → Environment Variables

# URL of your deployed backend (no trailing slash)
# Example: https://biosonic-backend.onrender.com
VITE_API_URL=https://your-backend.onrender.com
